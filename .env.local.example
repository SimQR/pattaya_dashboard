# Full base URL of the staging campaign API (includes /api/campaign).
CAMPAIGN_API_BASE=http://127.0.0.1:3456/api/campaign

# The Api-Key value configured in the o2ramp backend config.json -> apiAccessControl.
# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_ (that would ship it to the browser).
STAGING_API_KEY=abcdefghijklmnopqrstuvwxyz1234567890

# Optional shared password gating the dashboard. If set, the UI must send it and
# the proxy rejects requests without it. Leave empty to disable the gate.
DASHBOARD_PASSWORD=change-me
